---
import Footer from "../../components/Footer.astro";
---
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>High scores page</title>
	<style>
	    /* Font import */
		@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap');

		/* CSS */
		body {
    		background-color: #f4f4f9;
    		font-family: Arial, sans-serif;
		}
	    .container {
    		max-width: 600px;
    		margin: 50px auto;
    		padding: 20px;
    		background-color: #fff;
    		box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
		}

		h1 {
    		font-size: 2em;
    		text-align: center;
    		margin-bottom: 1rem;
		}

		ul {
			list-style-type: none;
			padding: 0;
		}

		.score-item {
			margin-bottom: .5rem;
			border: 1px solid grey;
			border-left: 5px solid greenyellow;
			border-radius: 50px;
			padding: 10px;
			display: flex;
			justify-content: space-between;
			align-items: center;
		}

		li:last-child {
			border-bottom: 1px solid grey;
		}

		p {
			font-family: 'JetBrains Mono', monospace;
		}

		.center {
			display: flex;
			justify-content: center;
			align-items: center;
			height: 100vh;
		}

		a {
			text-decoration: none;
			color: #007bff;
		}

		a:hover {
			text-decoration: underline;
		}
	</style>
</head>
<body>
    <!-- Actual Astro -->
    <div class="container">
    	<h1>High Scores Page - Dino square</h1>
    	<ul id="score-list">
           	<li class="score-item">
                Loading Data...
           	</li>
    	</ul>
    </div>
    <!-- <footer>
        <p class="footerText">
            To add your score, email <a href="mailto:alrisdhanwani@protonmail.com">alrisdhanwani@protonmail.com</a> with your username, score and an image of your score.
            To play the game, go to <a href="https://mrcheesie.github.io/alris_games/dino/">Bomb eater</a>.
        </p>
        <p class="footerText">&copy; Alris Dhanwani. All rights Reserved.</p>
    </footer> -->

		<div
		style="display: flex; align-items: center; justify-content: center;
		">
			<a href="rage/">Mad cause your score is so low? smash up the page</a>
		</div>

    <Footer />
</body>
<script>
    console.log("Script active");

		// yes, i know it's exposed. No, i don't care.
    const NOCO_DB_API_KEY = "nc_pat_EVD4yoyEYDElxQguKpGXw16IqJuXkwgllPDQvaXt";


    async function loadScoreboard() {
        console.log("Loading scores...");
        const options = {
            method: 'GET',
            headers: {'xc-token': NOCO_DB_API_KEY}
        };

        try {
            const response = await fetch("https://app.nocodb.com/api/v3/data/px2vuqfkfzvana1/mcgqlw8gcsfg9qq/records?pageSize=25&viewId=vwwk2gqml9o6u4hn", options);
            const data = await response.json();
            console.log("Data fetched:", data);

            if (!data.records) {
                console.error("No records found", data);
                return;
            }

            // Sort descending
            // @ts-ignore
            const sorted = data.records.sort((a, b) => b.fields.Score - a.fields.Score);

            // Get the <ul> element and clear it
            const scoreList: HTMLElement | null = document.getElementById("score-list");
            // @ts-ignore
            scoreList.innerHTML = "";

            // Build new <li> elements
            // @ts-expect-error
            sorted.forEach((entry, index) => {
                const li = document.createElement("li");
                li.className = "score-item";

                li.textContent = `${index + 1}. ${entry.fields.Username} - ${entry.fields.Score}`;

                //random color generator
                li.style.backgroundColor = `#${Math.floor(Math.random() * 16777215).toString(16)}`;
                li.style.backgroundColor = `#${Math.floor(Math.random() * 16777215).toString(16)}`;
                li.style.border = "1px solid grey";
                li.style.borderLeft = "5px solid greenyellow";
                li.style.borderRadius = "50px";
                li.style.padding = "10px";
                li.style.display = "flex";
                li.style.justifyContent = "space-between";
                li.style.alignItems = "center";

                // @ts-ignore
                scoreList.appendChild(li);
            });
        } catch (err) {
            console.error("Failed to load scoreboard:", err);
        }
    }

    // Call on page load
    loadScoreboard();
</script>
</html>
