---
import Footer from "../../components/Footer.astro";
---

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>High scores page</title>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap');

    body {
      background-color: #f4f4f9;
      font-family: Arial, sans-serif;
    }

    .container {
      max-width: 600px;
      margin: 50px auto;
      padding: 20px;
      background-color: #fff;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    h1 {
      font-size: 2em;
      text-align: center;
      margin-bottom: 1rem;
    }

    ul {
      list-style-type: none;
      padding: 0;
    }

    .score-item {
      margin-bottom: 0.5rem;
      border: 1px solid grey;
      border-left: 5px solid greenyellow;
      border-radius: 50px;
      padding: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    li:last-child {
      border-bottom: 1px solid grey;
    }

    p {
      font-family: 'JetBrains Mono', monospace;
    }

    .center {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    a {
      text-decoration: none;
      color: #007bff;
    }

    a:hover {
      text-decoration: underline;
    }
  </style>
</head>

<body>
  <div class="container">
    <h1>High Scores Page - Dino square</h1>
    <ul id="score-list">
      <li class="score-item">Loading Data...</li>
    </ul>
  </div>

  <Footer />

  <script>
    const NOCO_DB_API_KEY = "nc_pat_EVD4yoyEYDElxQguKpGXw16IqJuXkwgllPDQvaXt";
    const NOCO_DB_ENDPOINT =
      "https://app.nocodb.com/api/v3/data/px2vuqfkfzvana1/mcgqlw8gcsfg9qq/records?pageSize=25&viewId=vwwk2gqml9o6u4hn";

    async function loadScoreboard() {
      const scoreList = document.getElementById("score-list");

      if (!scoreList) {
        throw new Error('Could not find element with id "score-list".');
      }

      const response = await fetch(NOCO_DB_ENDPOINT, {
        method: "GET",
        headers: {
          "xc-token": NOCO_DB_API_KEY
        }
      });

      if (!response.ok) {
        throw new Error(`NocoDB request failed with status ${response.status}`);
      }

      const data = await response.json();

      if (!Array.isArray(data.records)) {
        throw new Error("NocoDB response did not contain a records array.");
      }

      const sortedRecords = data.records.sort(
        (a, b) => Number(b.fields.Score) - Number(a.fields.Score)
      );

      scoreList.replaceChildren();

      for (const [index, entry] of sortedRecords.entries()) {
        const li = document.createElement("li");
        li.className = "score-item";
        li.textContent =
          `${index + 1}. ${entry.fields.Username} - ${entry.fields.Score}`;

        // Optional random background color:
        li.style.backgroundColor =
          `#${Math.floor(Math.random() * 0xffffff)
            .toString(16)
            .padStart(6, "0")}`;

        scoreList.appendChild(li);
      }
    }

    async function startPage() {
      const scoreList = document.getElementById("score-list");

      try {
        await loadScoreboard();
      } catch (error) {
        console.error("Failed to load scoreboard:", error);

        if (scoreList) {
          scoreList.textContent = "Could not load scores.";
        }
      }

      // Register RageLayer only after the scoreboard has finished loading.
      try {
        await import("ragelayer/element");

        const rageLayer = document.createElement("rage-layer");
        rageLayer.setAttribute("initial-tool", "hammer");
        document.body.appendChild(rageLayer);
      } catch (error) {
        console.error("Failed to load RageLayer:", error);
      }
    }

    startPage();
  </script>
</body>
</html>
