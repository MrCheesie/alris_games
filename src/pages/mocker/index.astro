---
import Footer from "../../components/Footer.astro";
import "./style.css";
---
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!--Font embed -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">

    <title>Random case generator</title>
</head>
<body>
    <div id="container">
        <div>
            <form id="formy">
                <label for="textInput">Enter text here:</label>
                <input type="text" name="textInput" id="textInput" value="Enter text to randomly capitalize here ">
                <br><br>
                <button type="submit">Generate text</button>
            </form>
        </div>
        <div>
            <button type="button" id="copyBtn">Copy</button>
            <p id="result">mocK text WiLl APpEaR hErE</p>
        </div>
    </div>

    <script src="./app.js"></script>

    <Footer />

</body>
</html>
