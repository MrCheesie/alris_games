---
import "./tiers.css";
import Footer from "../../components/Footer.astro";
import toggleLayoutImg from "./toggle_layout.png";
import exportImg from "./export.png";
import plusImg from "./plus.png";
import resetImg from "./reset.png";
import importImg from "./import.png";
import binOpenImg from "./trash_bin_open.png";
import binImg from "./trash_bin.png";
---
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Offline TierMaker (Mobile)</title>
    <style>
      .mobile-hint { color: #ccc; font-size: 14px; text-align: center; margin: 8px 10px 0; }
      .item.selected { outline: 3px solid #fff; outline-offset: -3px; filter: brightness(1.1); }
      .tap-target { box-shadow: inset 0 0 0 2px rgba(255,255,255,0.15); }
      .images .item, .tierlist .item { display: inline-flex; }
      @media (max-width: 700px) {
        .top-container { position: static; height: auto; justify-content: center; margin-bottom: 8px; }
        .top-container * { height: 48px; }
        .buttons-container { width: auto; justify-content: center; }
        .button { height: 72px; }
        .button img { height: 72px; width: auto; }
      }
    </style>
  </head>
  <body>
    <div class='title'>
        <label class='title-label' for='title-input'>My TierList</label>
        <input type='text' id='title-input' />
    </div>
    <p class="mobile-hint">Tap an image to select it, then tap a tier or the image pool to place it. Tap the trash to delete a selected image. Double-tap an image to zoom.</p>
    <div class="top-container">
        <img id='trash' src={binImg.src} data-bin-open={binOpenImg.src} data-bin-closed={binImg.src} title='Delete selected image'>
        <div class='button'>
            <label for='toggle-layout'>
                <img src={toggleLayoutImg.src} title='Toggle Layout'/>
            </label>
            <input id='toggle-layout' type='button'/>
        </div>
    </div>
    <section class='main-content'>
        <div class='tierlist'></div>
        <div class='toggleable-container'>
            <div class='bottom-container'>
                <div class='buttons-container'>
                    <div class='button'>
                        <label for='load-img-input'><img src={plusImg.src} title='Add images'/></label>
                        <input id='load-img-input' type='file' accept='image/*' multiple/>
                    </div>
                    <div class='button'>
                        <label for='reset-list-input'><img src={resetImg.src} title='Reset list'></label>
                        <input id='reset-list-input' type='button' />
                    </div>
                    <div class='button'>
                        <label for='export-input'><img src={exportImg.src} title='Export'></label>
                        <input id='export-input' type='button' />
                    </div>
                    <div class='button'>
                        <label for='import-input'><img src={importImg.src} title='Import'/></label>
                        <input id='import-input' type='file' accept='.json' />
                    </div>
                </div>
                <section class='images'></section>
            </div>
        </div>
    </section>

    <div id="imageModal" class="image-modal" role="dialog" aria-modal="true" aria-label="Enlarged image">
      <button id="closeModal" class="close-modal" aria-label="Close enlarged image">&times;</button>
      <img id="modalImage" src="" alt=""/>
      <div class='title' id="modalCaption">
          <label class='title-label' id='modalCaptionLabel' for='modalCaptionInput'>(untitled)</label>
          <input type='text' id='modalCaptionInput' />
      </div>
    </div>
    <Footer />
    <script>
      import "../../scripts/tiers-mobile.js";
    </script>
  </body>
</html>
