---
import Footer from '../../components/Footer.astro'; // import Footer element
import "./style.css"; // import css
import { readFileSync } from "node:fs";
import { join } from "node:path";
const base: string = import.meta.env.BASE_URL;

// game json import
import no from "../no/details.json";
import mocker from "../mocker/details.json";
import draw from "../draw/details.json";
import qr from "../qr-maker/details.json";
import spammer from "../spammer/details.json";
import bsod from "../bsod/details.json";
import pdf from "../pdf/details.json";
import blog from "../blog/details.json";
import notifs from "../fakeNotifs/details.json";
import quiz from "../quiz/details.json";
// The docs site is now a Starlight content collection, so its details.json no
// longer sits in src/content/docs/. It lives outside the content folder.
import docsDetails from "../../data/docs.json";

// Games that live in public/ are copied as-is and never enter the Vite module
// graph, so their details.json cannot be imported. Read them from disk instead.
interface GameDetails {
    name: string;
    author: string;
    date: string;
    description: string;
}

function publicGameDetails(folder: string): GameDetails {
    return JSON.parse(readFileSync(join(process.cwd(), "public", folder, "details.json"), "utf-8"));
}

const pong: GameDetails = publicGameDetails("pong");
const bombEater: GameDetails = publicGameDetails("bomb_eater");
const rtg: GameDetails = publicGameDetails("RTG");
const aiHarness: GameDetails = publicGameDetails("AI-harness");
const tag: GameDetails = publicGameDetails("tag");

---
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Games</title>
</head>
<body>
    <div class="centerz">
        <ul id="list">
            <li id="mysteryBox" class="mysteryBox">
                <h2 class="mysteryBox">Mystery Pick</h2>
                <p class="mysteryBox">Go to a random game/tool.</p>
                <br>
                <a class="button" id="mysteryBtn">?</a> <br>
            </li>
            <br>
            <hr>
            <br>
            <li id="floppyBird">
                <h2>Floppy Bird</h2>
                <p>The OG game. Flap about in this game, and make sure you don't get doomed.</p>
                <br>
                <a href="https://transcendent-peony-c6d089.netlify.app/" class="button">Game</a> <br>
                <a href="https://floppybirdhighscores.netlify.app" class="button">Scoreboard</a>
            </li>
        <br><hr><br>
            <li id="spammer">
                <h2>{spammer.name}</h2>
                <p>{spammer.description}</p>
                <br>
                <a href="../spammer/" class="button">Annoy people!</a> <br>
            </li>
        <br><hr><br>
            <li id="mocker">
                <h2>{mocker.name}</h2>
                <p>{mocker.description}</p>
                <br>
                <a href="../mocker/" class="button">Annoy people!</a> <br>
            </li>
            <br><hr><br>
            <li id="draw">
                <h2>{draw.name}</h2>
                <p>{draw.description}</p>
                <br>
                <a href="../draw/" class="button">Drawing app</a> <br>
            </li>
        <br><hr><br>
            <li id="qrMaker">
                <h2>{qr.name}</h2>
                <p>{qr.description}</p>
                <br>
                <a href="../qr-maker/" class="button">Make a QR code</a> <br>
            </li>
        <br><hr><br>
            <li id="errorScreen">
                <h2>{bsod.name}</h2>
                <p>{bsod.description}</p>
                <br>
                <a href={`${base}/bsod/`} class="button">Pretend to have an error</a> <br>
            </li>
        <br><hr><br>
            <li id="pdf">
                <h2>{pdf.name}</h2>
                <p>{pdf.description}</p>
                <br>
                <a href={`${base}/pdf/`} class="button">Annotate PDFs</a>
            </li>
        <br><hr><br>
            <li id="pong">
                <h2>{pong.name}</h2>
                <p>{pong.description}</p>
                <br>
                <a href={`${base}/pong/`} class="button">Pong</a>
            </li>
        <br><hr><br>
            <li id="bombEater">
                <h2>{bombEater.name}</h2>
                <p>{bombEater.description}</p>
                <br>
                <a href={`${base}/bomb_eater/`} class="button">Game</a>
                <a href={`${base}/bomb_eater/scores.html`} class="button">Scores</a>
            </li>
        <br><hr><br>
            <li id="noSayer">
                <h2>{no.name}</h2>
                <p>{no.description}</p>
                <!--<p>Ever wanted to refuse without sounding offensive? Now, you can get witty and funny ways to say no using this website. </p>-->
                <br>
                <a href="../no/" class="button">Say no</a>
            </li>
        <br><hr><br>
            <li id="RandomTeamGenerator">
                <h2>{rtg.name}</h2>
                <p>{rtg.description}</p>
                <br>
                <a href={`${base}/RTG/`} class="button">Free version</a>
                <a href={`${base}/RTG/paid.html`} class="button">Premium version</a>
            </li>
        <br><hr><br>
            <li id="aiHarness">
                <h2>{aiHarness.name}</h2>
                <p>{aiHarness.description}</p>
                <br>
                <a href={`${base}/AI-harness/`} class="button">Chat with AI</a>
            </li>
        <br><hr><br>
            <li id="tag">
                <h2>{tag.name}</h2>
                <p>{tag.description}</p>
                <br>
                <a href={`${base}/tag/`} class="button">Play Tag!</a>
            </li>
        <br><hr><br>
            <li id="fakeNotifs">
                <h2>{notifs.name}</h2>
                <p>{notifs.description}</p>
                <br>
                <a href={`../fakeNotifs/`} class="button">Get notifications!</a>
            </li>
            <br><hr><br>
            <li id="quiz">
                <h2>{quiz.name}</h2>
                <p>{quiz.description}</p>
                <br>
                <a href="../quiz/" class="button">Play Quiz</a>
            </li>
            <br><hr><br>
        <li id="blogs">
            <h2>{blog.name}</h2>
            <p>{blog.description}</p>
            <br>
            <a href="../blog/" class="button">Blog</a>
        </li>
        <br><hr><br>
        <li id="docs">
            <h2>{docsDetails.name}</h2>
            <p>{docsDetails.description}</p>
            <br>
            <a href={`${base}/docs/`} class="button">Read docs</a>
        </li>
        <br><hr><br>
        </ul>
    </div>

    <Footer />
    <!-- Send base to script -->
    <div id="data-div" data-my-var={base}></div>
    <!-- TS script -->
    <script>import "../../scripts/games.ts";</script>
</body>
</html>
