---
import Footer from '../../components/Footer.astro'; // import Footer element
import "./style.css"; // import css
const base: string = import.meta.env.BASE_URL;

// game json import
import no from "../no/details.json";
import docs from "../docs/details.json";
import mocker from "../mocker/details.json";
import draw from "../draw/details.json";
import qr from "../qr-maker/details.json";

---
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Games</title>
</head>
<body>
    <div class="centerz">
        <ul id="list">
            <li id="mysteryBox" class="mysteryBox">
                <h2 class="mysteryBox">Mystery Pick</h2>
                <p class="mysteryBox">Go to a random game/tool.</p>
                <br>
                <a class="button" id="mysteryBtn">?</a> <br>
            </li>
            <br>
            <hr>
            <br>
            <li id="floppyBird">
                <h2>Floppy Bird</h2>
                <p>The OG game. Flap about in this game, and make sure you don't get doomed.</p>
                <br>
                <a href="https://transcendent-peony-c6d089.netlify.app/" class="button">Game</a> <br>
                <a href="https://floppybirdhighscores.netlify.app" class="button">Scoreboard</a>
            </li>
        <br><hr><br>
            <li id="spammer">
                <h2>Text repeater</h2>
                <p>Ever wanted to spam someone with a message? Well now you can.</p>
                <br>
                <a href="../spammer/" class="button">Annoy people!</a> <br>
            </li>
        <br><hr><br>
            <li id="mocker">
                <h2>{mocker.name}</h2>
                <p>{mocker.description}</p>
                <br>
                <a href="../mocker/" class="button">Annoy people!</a> <br>
            </li>
            <br><hr><br>
            <li id="draw">
                <h2>{draw.name}</h2>
                <p>{draw.description}</p>
                <br>
                <a href="../draw/" class="button">Drawing app</a> <br>
            </li>
        <br><hr><br>
            <li id="qrMaker">
                <h2>{qr.name}</h2>
                <p>{qr.description}</p>
                <br>
                <a href="../qr-maker/" class="button">Make a QR code</a> <br>
            </li>
        <br><hr><br>
            <li id="errorScreen">
                <h2>Fake error screen</h2>
                <p>Prank your friends or get out of doing work with these fake blue screens of death.</p>
                <br>
                <a href="../bsod/index.astro" class="button">Pretend to have an error</a> <br>
            </li>
        <br><hr><br>
            <li id="pdf">
                <h2>PDF annotater</h2>
                <p>Annotate, read, and redact PDFs in your browser for free.</p>
                <br>
                <a href="../pdf/index.html" class="button">Annotate PDFs</a>
            </li>
        <br><hr><br>
            <li id="pong">
                <h2>2-player pong game</h2>
                <p>Play pong with your friend.</p>
                <br>
                <a href=`${base}/pong/` class="button">Pong</a>
            </li>
        <br><hr><br>
            <li id="bombEater">
                <h2>Bomb eater</h2>
                <p>Eat coins, try not to explode.</p>
                <br>
                <a href="../../../public/bomb_eater/index.html" class="button">Game</a>
                <a href="../../../public/bomb_eater/scores.html" class="button">Scores</a>
            </li>
        <br><hr><br>
            <li id="noSayer">
                <h2>{no.name}</h2>
                <p>{no.description}</p>
                <!--<p>Ever wanted to refuse without sounding offensive? Now, you can get witty and funny ways to say no using this website. </p>-->
                <br>
                <a href="../no/" class="button">Say no</a>
            </li>
        <br><hr><br>
            <li id="RandomTeamGenerator">
                <h2>Random team generator</h2>
                <p>Create random teams and groups with this random group generator.  </p>
                <br>
                <a href=`${base}/RTG/` class="button">Free version</a>
                <a href=`${base}/RTG/paid.html` class="button">Premium version</a>
            </li>
        <br><hr><br>
            <li id="aiHarness">
                <h2>Use AI with your own API keys</h2>
                <p>Use this AI chat harness with your own API keys. Google AI Studio recommended</p>
                <br>
                <a href="../../../public/AI-harness/" class="button">Chat with AI</a>
            </li>
        <br><hr><br>
            <li id="tag">
                <h2>Play Tag</h2>
                <p>Play tag together with your friends! Not compatible with mobile.</p>
                <br>
                <a href="../../../public/tag/" class="button">Play Tag!</a>
            </li>
        <br><hr><br>
        <li id="blogs">
            <h2>Blogs</h2>
            <p>Read and view blogs made by people and make your own.</p>
            <br>
            <a href="../blog/" class="button">Blog</a>
        </li>
        <br><hr><br>
        <li id="docs">
            <h2>{docs.name}</h2>
            <p>{docs.description}</p>
            <br>
            <a href="../docs/" class="button">Read docs</a>
        </li>
        <br><hr><br>
        </ul>
    </div>

    <Footer />
    <!-- TS script -->
    <script>import "../../scripts/games.ts";</script>
</body>
</html>
