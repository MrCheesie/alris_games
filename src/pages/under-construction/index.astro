<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Under Construction</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&display=swap" rel="stylesheet" />
  <style is:inline>
    *, ::before, ::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #010101;
      overflow: hidden;
    }
    .uc-canvas { transform-origin: center center; will-change: transform; }
    .uc-stage { will-change: transform; }
    .uc-stage.shake { animation: ucShake .6s ease-in-out; }
    .uc-sound {
      position: fixed;
      right: 18px;
      bottom: 18px;
      z-index: 50;
      border: 1px solid #333;
      background: #111;
      color: #f1f1f1;
      font-size: 18px;
      line-height: 1;
      padding: 10px 12px;
      border-radius: 9999px;
      cursor: pointer;
      opacity: .75;
      transition: opacity .2s ease, transform .2s ease;
    }
    .uc-sound:hover { opacity: 1; transform: scale(1.08); }

    @keyframes ucShake {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      12% { transform: translate(-10px, 6px) rotate(-0.8deg); }
      25% { transform: translate(12px, -8px) rotate(1deg); }
      38% { transform: translate(-8px, -5px) rotate(-0.6deg); }
      50% { transform: translate(14px, 7px) rotate(1.2deg); }
      62% { transform: translate(-12px, 4px) rotate(-1deg); }
      75% { transform: translate(9px, -6px) rotate(0.7deg); }
      88% { transform: translate(-6px, 8px) rotate(-0.5deg); }
    }

    .uc-text {
      opacity: 0;
      transform: translateY(24px);
      animation: ucTextIn 1.2s cubic-bezier(.2,.8,.2,1) .3s forwards;
    }
    .uc-crack path {
      stroke-dasharray: 1000;
      stroke-dashoffset: 1000;
      animation: ucDraw 2.4s ease-out .6s forwards;
    }
    .uc-zigzag path {
      opacity: 0;
      animation: ucFade 1.6s ease-out 1.4s forwards;
    }
    .uc-tape {
      opacity: 0;
      animation: ucTapeIn 1s ease-out forwards;
    }
    .uc-tape:nth-child(2) { animation-delay: .15s; }
    .uc-tape:nth-child(3) { animation-delay: .3s; }

    @keyframes ucTextIn {
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes ucDraw {
      to { stroke-dashoffset: 0; }
    }
    @keyframes ucFade {
      to { opacity: 1; }
    }
    @keyframes ucTapeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @media (prefers-reduced-motion: reduce) {
      .uc-text, .uc-crack path, .uc-zigzag path, .uc-tape {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
        stroke-dashoffset: 0 !important;
      }
    }
  </style>
</head>
