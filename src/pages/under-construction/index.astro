  <button class="uc-sound" type="button" aria-label="Toggle drilling sound">🔊</button>
  <script is:inline>
    (function () {
      var canvas = document.querySelector('.uc-canvas');
      var stage = document.querySelector('.uc-stage');
      if (!canvas) return;
      var tapes = Array.prototype.slice.call(document.querySelectorAll('.uc-tape'));
      var baseTransforms = tapes.map(function (t) { return t.style.transform || ''; });

      function fit() {
        var sx = window.innerWidth / 844.423;
        var sy = window.innerHeight / 600;
        var s = Math.max(sx, sy);
        canvas.style.transform = 'scale(' + s + ')';
      }
      fit();
      window.addEventListener('resize', fit);

      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Gentle drifting motion for the construction tapes.
      if (!reduced) {
        var start = performance.now();
        function loop(now) {
          var t = (now - start) / 1000;
          tapes.forEach(function (tape, i) {
            var dx = Math.sin(t * 0.6 + i * 1.7) * 18;
            var dy = Math.cos(t * 0.4 + i * 2.1) * 6;
            tape.style.transform = 'translate(' + dx + 'px,' + dy + 'px) ' + baseTransforms[i];
          });
          requestAnimationFrame(loop);
        }
        requestAnimationFrame(loop);

        // Random shake bursts.
        function scheduleShake() {
          var delay = 4000 + Math.random() * 7000;
          setTimeout(function () {
            if (stage) {
              stage.classList.add('shake');
              setDrillActive(true);
              setTimeout(function () {
                stage.classList.remove('shake');
                setDrillActive(false);
              }, 650);
            }
            scheduleShake();
          }, delay);
        }
        scheduleShake();
      }

      // Drilling sound: on by default, audible only during shakes.
      var audioCtx = null;
      var drillNodes = null;
      var drillEnabled = true;
      var btn = document.querySelector('.uc-sound');

      function makeNoiseBuffer(ctx, seconds) {
        var size = ctx.sampleRate * seconds;
        var buffer = ctx.createBuffer(1, size, ctx.sampleRate);
        var data = buffer.getChannelData(0);
        for (var i = 0; i < size; i++) data[i] = Math.random() * 2 - 1;
        return buffer;
      }

      function ensureDrill() {
        if (drillNodes) return drillNodes;
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') { try { audioCtx.resume(); } catch (e) {} }
        var noise = audioCtx.createBufferSource();
        noise.buffer = makeNoiseBuffer(audioCtx, 2);
        noise.loop = true;
        var filter = audioCtx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 1100;
        filter.Q.value = 1.2;
        var gain = audioCtx.createGain();
        gain.gain.value = 0.0;
        var lfo = audioCtx.createOscillator();
        lfo.frequency.value = 13;
        var lfoGain = audioCtx.createGain();
        lfoGain.gain.value = 0.12;
        lfo.connect(lfoGain);
        lfoGain.connect(gain.gain);
        var clatter = audioCtx.createOscillator();
        clatter.type = 'square';
        clatter.frequency.value = 42;
        var clatterGain = audioCtx.createGain();
        clatterGain.gain.value = 0.025;
        clatter.connect(clatterGain);
        clatterGain.connect(gain.gain);
        noise.connect(filter);
        filter.connect(gain);
        gain.connect(audioCtx.destination);
        noise.start();
        lfo.start();
        clatter.start();
        drillNodes = { noise: noise, lfo: lfo, clatter: clatter, gain: gain };
        return drillNodes;
      }

      function setDrillActive(active) {
        if (!drillEnabled) active = false;
        var nodes = ensureDrill();
        if (!nodes || !audioCtx) return;
        try {
          if (audioCtx.state === 'suspended') audioCtx.resume();
          var now = audioCtx.currentTime;
          nodes.gain.gain.cancelScheduledValues(now);
          nodes.gain.gain.setValueAtTime(nodes.gain.gain.value, now);
          if (active) {
            nodes.gain.gain.linearRampToValueAtTime(0.18, now + 0.12);
          } else {
            nodes.gain.gain.linearRampToValueAtTime(0.0, now + 0.18);
          }
        } catch (e) {}
      }

      // try to enable audio on load (may require interaction)
      try { ensureDrill(); } catch (e) {}
      // resume on first interaction
      function resumeAudio() {
        if (audioCtx && audioCtx.state === 'suspended') { try { audioCtx.resume(); } catch (e) {} }
      }
      window.addEventListener('click', resumeAudio, { once: true });
      window.addEventListener('keydown', resumeAudio, { once: true });

      if (btn) {
        btn.textContent = drillEnabled ? '🔊' : '🔇';
        btn.addEventListener('click', function () {
          drillEnabled = !drillEnabled;
          btn.textContent = drillEnabled ? '🔊' : '🔇';
          if (!drillEnabled) setDrillActive(false);
        });
      }

      // schedule shakes and tie sound to them
      if (!reduced) {
        // update shake scheduling to call setDrillActive
        var origSchedule = null;
      }
    })();
  </script>
