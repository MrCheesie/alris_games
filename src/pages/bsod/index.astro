---
import Footer from "../../components/Footer.astro";
import "./style.css";
import bsodImage from "./assets/bsod.webp";
import eroorImage from "./assets/eroor.gif";
---
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fake Blue screens of death</title>
</head>
<body>

  <!-- The Grid of Images -->
  <main class="grid-container">
    <div class="image-grid">
      <!-- Click any of these to trigger full hardware fullscreen -->
      <!-- TODO: Add more assets -->
      <img src={bsodImage.src} class="bsod-trigger" alt="BSOD Options 1">
      <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTma86Vb0tKjIuml_irLabeAfX-TyiRpBWNAOJ_9AMhlQ&s=10" class="bsod-trigger" alt="Windows BSOD Options 2">
      <img src="https://cdsassets.apple.com/live/7WUAS350/images/macos/macos-startup-apple-logo-progress-bar.png" class="bsod-trigger" alt="MacOS BSOD Options 3">
      <img src={eroorImage.src} class="bsod-trigger" alt="Error screen Windows BSOD Options 4">
      <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSCDkOQBXktfNPrS8hUh5x9Ik4rEt-JSNXSSRyJ1V-CufuhHH9ocxR-UvFL&s=10" class="bsod-trigger" alt="Windows BSOD Options 5">
      <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTVo23GVPEoyYD_4_N7kILseU2dVH3dWViTQEuL_JqGXd0DLyeD9DgtDK78&s=10" class="bsod-trigger" alt="Android BSOD Options 6">
    </div>
  </main>

  <script>
    import './app.js';
  </script>

  <Footer />

</body>
</html>
