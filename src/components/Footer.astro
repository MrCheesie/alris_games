---
interface Props {
  copyright?: string;
  homeUrl?: string;
  homeLabel?: string;
}

const {
  copyright = '© 2026 Alris Dhanwani | Apache 2.0',
  homeUrl = '/alris_games/',
  homeLabel = 'Return to homepage'
} = Astro.props;
---

<footer class="footer">
  <slot/>
  <p id="copyRight">{copyright}</p>
  <a href={homeUrl} id="buh">{homeLabel}</a>
</footer>
<style>
  #copyRight {
    font-family: 'JetBrains Mono', monospace;
    color: var(--color-footer-text, #f1f5f9);
  }

  #buh {
    font-family: 'JetBrains Mono', monospace;
    color: #67e8f9;
  }

  #buh:hover {
    color: #a5f3fc;
  }

  footer.footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: var(--color-footer-bg, #1e293b);
    color: var(--color-footer-text, #f1f5f9);
    text-align: center;
    padding: 1rem;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    z-index: 1000;
    border-top: 1px solid var(--color-border, #334155);
    min-height: 70px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
  }

  footer.footer > p {
    margin: 0;
    font-size: 0.875rem;
  }

  @media (max-width: 640px) {
    footer.footer {
      position: static;
      margin-top: 3rem;
    }
  }
</style>
